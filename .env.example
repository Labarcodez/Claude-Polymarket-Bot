# Copy this file to .env and fill in your own values. NEVER commit .env.
# .env is already covered by .gitignore.

# --- Anthropic (Claude) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- Polymarket wallet ---
# The private key of the Polygon wallet that will sign orders. This wallet
# (or the wallet it proxies for, see POLYMARKET_FUNDER_ADDRESS below) must
# hold the USDC.e you intend to trade with and, for an EOA wallet, some POL
# for the one-time allowance-approval transactions.
#
# SECURITY: this key can move funds. Use a wallet dedicated to this bot only
# never your main wallet, never a key with other funds/permissions on it.
POLYMARKET_PRIVATE_KEY=

# The address that actually holds trading funds.
#   - EOA wallet (signature_type=0): same address as the key above; you can
#     leave this blank and the bot will use the key's own address.
#   - Polymarket email/Magic login (signature_type=1) or a Gnosis Safe / proxy
#     wallet (signature_type=2): set this to the proxy address shown under
#     polymarket.com -> Settings, NOT your signer EOA.
POLYMARKET_FUNDER_ADDRESS=

# --- Kalshi account ---
# Only needed if config.yaml has `exchange: kalshi` (or you pass
# `polybot --exchange kalshi`). Kalshi authenticates with an API key ID plus
# an RSA key pair you generate and upload the *public* half of at
# kalshi.com -> Settings -> API Keys. Never upload or share the private half.
#
# The Key ID (a UUID) shown after you upload your public key:
KALSHI_API_KEY_ID=
# Path to the PEM file holding your RSA *private* key:
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
# Alternative to the path above: paste the PEM contents directly (useful if
# you're injecting this from a secrets manager rather than a file on disk).
# Escape newlines as \n if you keep it on one line. Leave blank if you're
# using KALSHI_PRIVATE_KEY_PATH instead.
# KALSHI_PRIVATE_KEY=

# --- Safety ---
# The bot refuses to place real orders unless this is exactly "yes". This is
# an intentional second gate on top of config.yaml's `mode: live` so that
# going live is never a one-line accident. Leave unset/blank for paper
# trading (dry_run mode ignores this entirely).
POLYBOT_CONFIRM_LIVE=

# Optional: override config.yaml's top-level mode/exchange without editing
# the file.
# POLYBOT_MODE=dry_run          # dry_run | live
# POLYBOT_EXCHANGE=polymarket   # polymarket | kalshi
